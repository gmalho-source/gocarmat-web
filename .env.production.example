# GOCARMAT — template de .env para produção (cPanel)
# Copiar para .env no servidor e preencher os valores marcados com <...>

APP_NAME=GOCARMAT
APP_ENV=production
APP_KEY=            # gerar no servidor: php artisan key:generate
APP_DEBUG=false
APP_URL=https://www.gocarmat.pt
APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL (criar em cPanel > MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nome_da_bd>
DB_USERNAME=<utilizador_bd>
DB_PASSWORD=<password_bd>

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database

# SMTP do domínio (cPanel > Email Accounts) — para notificações de marcações
MAIL_MAILER=smtp
MAIL_HOST=mail.gocarmat.pt
MAIL_PORT=465
MAIL_USERNAME=<no-reply@gocarmat.pt>
MAIL_PASSWORD=<password_smtp>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@gocarmat.pt
MAIL_FROM_NAME="${APP_NAME}"
